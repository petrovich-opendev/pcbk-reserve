# Прокси входа стенда. Образ nginx кладёт этот шаблон в conf.d внутри http{} —
# здесь server-блоки и то, что nginx принимает только на уровне http (map, limit_req_zone).
# Переменных окружения в шаблоне нет: envsubst меняет только имена из окружения,
# а у edge своих переменных нет.

# вне server{}: сырой путь под /pcbk/api/ (до первого «?») с кодированными точками и слэшами, «/.» или «//» —
# отказ до core. Строку запроса edge не судит: её фильтрует шлюз (filter_query), и %2F, «[», «]» в ней законны
map $request_uri $pcbk_bad_api_uri {
    default 0;
    "~^[^?]*(%2[eEfF]|%5[cC]|/\.|//)" 1;
}
limit_req_zone $binary_remote_addr zone=pcbk_login:1m rate=5r/s;

# ответы под /pcbk/api/ и ошибки edge — не страница: CSP default-src 'none' (Д5б). По $uri — пути после
# нормализации (/%70cbk/…, /x/../pcbk/…) и после перехода error_page (/pcbk-errors/…). Пустое значение nginx не
# отправляет — у страниц сторожа и входа заголовка от этой строки нет (у входа свой CSP в его location)
map $uri $pcbk_api_csp {
    default "";
    "~^/pcbk(?:/api(?:/|$)|-errors/)" "default-src 'none'";
}

# кэш ассетов чата (Д6-R41): имена с хешем содержимого — год и immutable, но только у ответа с файлом (200, 304).
# Отказ — 404 в окне переименования при выкладке, опечатка в пути — no-store, как всё прочее у edge (правило Д1):
# иначе браузер запомнил бы 404 на год под тем же именем
map $status $pcbk_asset_cache {
    default "no-store";
    200     "public, max-age=31536000, immutable";
    304     "public, max-age=31536000, immutable";
}

# журнал доступа 8443 — без строки запроса (в ней бывает auth_token адаптера OpenCode): строка запроса клиента как
# пришла — метод, сырой путь до «?» и версия; метод — из строки запроса, а не $request_method: после error_page тот — GET
map $request $pcbk_log_request {
    default "-";
    "~^(\S+) ([^?\s]*)\S* (\S+)$" "$1 $2 $3";
}
log_format pcbk '$remote_addr - $remote_user [$time_local] "$pcbk_log_request" '
                '$status $body_bytes_sent "$http_referer" "$http_user_agent" "$http_x_forwarded_for"';

# /pcbk/api/oc/: одновременных запросов на cookie сессии и всего (Д5б). Ключ — значение cookie только своего вида
# (token_urlsafe(32), 43 знака); без cookie и с cookie иного вида — одна общая корзина «-» (те же 10): запросы без
# учётки не займут общий предел. Поддельные cookie своего вида — каждая своя корзина (остаточный риск, README)
map $cookie_pcbk_session $pcbk_oc_session {
    default "-";
    "~^[A-Za-z0-9_-]{43}$" $cookie_pcbk_session;
}
limit_conn_zone $pcbk_oc_session zone=pcbk_oc_session:1m;
limit_conn_zone $server_port zone=pcbk_oc_all:1m;               # ключ один на server 8443 — общий предел
# частота на cookie сессии (итоговая доводка Д5б, N1): вызовы — 20 в секунду с запасом 200 (одна таблица случаев —
# 124 запроса подряд), и одна cookie не вымывает журнал core строками «gw refused». У потока — своя зона: адаптер
# переподключается до 6 раз в секунду на вкладку (три вкладки — 18), а отказы потока core сам сворачивает в строку
# в минуту; своя зона не даёт переподключениям съесть запас вызовов
limit_req_zone $pcbk_oc_session zone=pcbk_oc_rate:1m rate=20r/s;
limit_req_zone $pcbk_oc_session zone=pcbk_oc_event:1m rate=20r/s;
# ручки места (остаток Д5б): та же карта cookie, без cookie — корзина «-»; страница входа опрашивает состояние раз в
# секунду, чат — реже; поток запросов без учётки не доходит до core сверх 5 в секунду
limit_req_zone $pcbk_oc_session zone=pcbk_place_rate:1m rate=5r/s;
# отчёты браузеров о молчании чата (Д6б, Д6-R50): та же карта cookie, без cookie — корзина «-»; не по IP — весь класс
# бывает за одним адресом. Браузер шлёт отчёт раз в эпизод, core считает не чаще раза в минуту на (логин, вид)
limit_req_zone $pcbk_oc_session zone=pcbk_web:1m rate=1r/s;

# временные файлы тел запросов и ответов core — на томе pcbk-edge-temp (диск), не в tmpfs: tmpfs считается в
# mem_limit 64m edge, а ответ core — до 4 МиБ (Д5-R36), тело /pcbk/api/oc/ — до 512 КиБ. Каталоги создаёт мастер
client_body_temp_path /var/lib/pcbk-edge/client;
proxy_temp_path       /var/lib/pcbk-edge/proxy;

# 8443 — вход для людей: заглушка, страница входа, пути шлюза /pcbk/api/ и страница состояния сторожа
server {
    listen 8443 ssl;
    http2 on;
    server_name _;
    server_tokens off;

    ssl_certificate     /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/access.log pcbk;          # без строки запроса (map выше)

    # сторож и core разрешаются в момент запроса: nginx стартует и без них
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 3s;
    set $pcbk_watchdog pcbk-watchdog:8090;
    set $pcbk_core pcbk-core:8000;

    root /usr/share/nginx/pcbk;

    # на всё, что отдаёт edge, — без кэша; одноимённые заголовки сторожа заменяются
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy $pcbk_api_csp always;   # только под /pcbk/api/ и /pcbk-errors/ (map выше)
    proxy_hide_header Cache-Control;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;

    # proxy_set_header — только здесь: location со своим proxy_set_header потерял бы все
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-Host $host;        # хост для доменов удалений cookie (Д5-R25)
    proxy_set_header X-Forwarded-For "";            # заголовки пересылки от клиента к core не доходят
    proxy_set_header X-Real-IP "";
    proxy_set_header Forwarded "";
    proxy_connect_timeout 3s;
    proxy_send_timeout 5s;
    proxy_read_timeout 5s;
    proxy_buffer_size 32k;                          # набор удалений cookie — до 16 КиБ заголовков (Д5-R30)
    proxy_buffers 8 32k;
    proxy_busy_buffers_size 64k;

    # ошибки самого nginx — JSON через внутренние location по URI, на уровне server: у строки с %00
    # URI ещё нет (именованный location дал бы 500 HTML), TRACE отвергается до выбора location.
    # location со своим error_page (страница состояния Д1) их не наследуют — и location под /pcbk/api/
    # своих error_page не ставят, иначе потеряют эти.
    error_page 400 /pcbk-errors/400.json;
    error_page 405 /pcbk-errors/405.json;
    error_page 413 /pcbk-errors/413.json;
    error_page 414 /pcbk-errors/414.json;                 # длинный адрес
    error_page 494 =400 /pcbk-errors/400.json;            # большие заголовки и cookie (cookie Dify на том же хосте)
    error_page 429 /pcbk-errors/429.json;
    error_page 502 503 504 =503 /pcbk-errors/503.json;    # «=503»: без него код остался бы 502 или 504
    error_page 509 =503 /pcbk-errors/busy.json;           # limit_conn и limit_req под /pcbk/api/oc/, у ручек места и отчётов (509 — только их код)

    location = /pcbk-errors/400.json { internal; default_type application/json; return 400 '{"name":"BadRequest","data":{"message":"Неверный запрос"}}'; }
    location = /pcbk-errors/405.json { internal; default_type application/json; return 405 '{"name":"MethodNotAllowed","data":{"message":"Неверный запрос"}}'; }
    location = /pcbk-errors/413.json { internal; default_type application/json; return 413 '{"name":"PayloadTooLarge","data":{"message":"Запрос слишком большой"}}'; }
    location = /pcbk-errors/414.json { internal; default_type application/json; return 414 '{"name":"URITooLong","data":{"message":"Адрес запроса слишком длинный"}}'; }
    location = /pcbk-errors/429.json { internal; default_type application/json; return 429 '{"name":"TooManyAttempts","data":{"message":"Слишком много попыток входа — подождите"}}'; }
    location = /pcbk-errors/503.json { internal; default_type application/json; return 503 '{"name":"Unavailable","data":{"message":"Серверный слой не отвечает"}}'; }
    location = /pcbk-errors/busy.json { internal; default_type application/json; return 503 '{"name":"WorkplaceBusy","data":{"message":"Слишком много одновременных запросов — повторите позже"}}'; }

    # р4: Host — ввод клиента (он же X-Forwarded-Host для core): имя из не больше шести меток [a-z0-9-]
    # или адрес IPv4, иначе 400 JSON до core. rewrite, а не «return 400»: серверный rewrite повторяется
    # при внутреннем переходе error_page, и вышла бы стандартная страница nginx
    if ($host !~* "^[a-z0-9-]{1,63}(\.[a-z0-9-]{1,63}){0,5}$") { rewrite ^ /pcbk-errors/host.json last; }
    location = /pcbk-errors/host.json { internal; default_type application/json; return 400 '{"name":"BadRequest","data":{"message":"Неверное имя сервера"}}'; }

    location = / {
        charset utf-8;
        try_files /index.html =404;
    }

    # в путях сторожа 502/503/504 от самого nginx (сторож умер или завис) — своя страница,
    # код сохраняется; ответы сторожа (503 до первого снимка) проходят как есть.
    # Только здесь: у других будущих путей своя беда, не «Сторож не отвечает»
    location = /status {
        error_page 502 503 504 /watchdog-down.html;
        proxy_pass http://$pcbk_watchdog;
    }

    location = /status.js {
        error_page 502 503 504 /watchdog-down.html;
        proxy_pass http://$pcbk_watchdog;
    }

    location = /status.json {
        access_log off;   # открытая страница опрашивает каждые 5 с
        error_page 502 503 504 /watchdog-down.html;
        proxy_pass http://$pcbk_watchdog;
    }

    location = /watchdog-down.html {
        internal;
        charset utf-8;
    }

    # страница входа — статика с CSP: скрипт и стили только файлами отсюда; у location со своим
    # add_header три заголовка server-блока не наследуются — повторены
    location = /login {
        charset utf-8;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'" always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files /login.html =404;
    }

    location = /login.js {
        charset utf-8;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'" always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files /login.js =404;
    }

    location = /login.css {
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'" always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files /login.css =404;
    }

    # чат (Д6-R39, R41): SPA из статики edge/static/chat/ — index.html и assets/* со своим CSP (строка Global
    # Constraints Д6, font-src сверх входа). Карта $pcbk_api_csp /chat/ не накрывает, а add_header в location
    # отменяет заголовки server — nosniff и Referrer-Policy повторены, как у /login. CSP R41 — у всех ответов /chat*,
    # и у перенаправления и 404 (итоговое ревью Д6а, P3)
    location = /chat {
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; font-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'" always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        absolute_redirect off;                    # Location относительный: через туннель абсолютный увёл бы на 8443
        return 301 /chat/;
    }

    location = /chat/ {
        charset utf-8;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; font-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'" always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files /chat/index.html =404;
    }

    # ассеты с хешем в имени: кэш на год (map $pcbk_asset_cache) и gzip — бандл около 914 КБ без сжатия
    location ^~ /chat/assets/ {
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; font-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'" always;
        add_header Cache-Control $pcbk_asset_cache always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        gzip on;
        gzip_types application/javascript text/javascript text/css;
        gzip_vary on;
        try_files $uri =404;
    }

    # загрузчик чата (Д6б, Д6-R51): имя без хеша, поэтому no-store своей location, а не год из assets/; точный «=»
    # сильнее ^~ /chat/ ниже. charset — в нём русский текст сбоя; заголовки server повторены, как у /chat/
    location = /chat/boot.js {
        charset utf-8;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; font-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'" always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files /chat/boot.js =404;
    }

    # прочее под /chat/ — не на 8443: опись build.json читает только сторож через 8080, index.html — только как /chat/.
    # types {} — тип ответа не по расширению пути (иначе 404 на build.json ушёл бы как application/json)
    location ^~ /chat/ {
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; font-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'" always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        types { }
        default_type "text/plain; charset=utf-8";
        return 404 "не найдено\n";
    }

    # браузер сам спрашивает иконку, а в страницах её нет: пустой ответ вместо 404 в журнале каждой загрузки
    location = /favicon.ico {
        access_log off;
        return 204;
    }

    # пути шлюза в core — только эти (Д5а, /pcbk/api/oc/ — Д5б); error_page, буферы, Connection "", X-Forwarded-Host
    # и заголовки ответа — от server: своих error_page, proxy_set_header и add_header здесь нет
    location /pcbk/api/auth/ {
        default_type application/json;
        if ($pcbk_bad_api_uri) { return 400 '{"name":"BadRequest","data":{"message":"неверный адрес"}}'; }
        limit_req zone=pcbk_login burst=20 nodelay;
        limit_req_status 429;
        client_max_body_size 64k;
        proxy_read_timeout 30s;
        proxy_pass http://$pcbk_core;
    }

    location = /pcbk/api/workplace {
        default_type application/json;
        if ($pcbk_bad_api_uri) { return 400 '{"name":"BadRequest","data":{"message":"неверный адрес"}}'; }
        limit_req zone=pcbk_place_rate burst=20 nodelay;
        limit_req_status 509;                     # busy.json — 503 WorkplaceBusy, как у /pcbk/api/oc/
        limit_req_log_level warn;
        client_max_body_size 64k;
        proxy_read_timeout 30s;
        proxy_pass http://$pcbk_core;
    }

    location = /pcbk/api/workplace/wake {
        default_type application/json;
        if ($pcbk_bad_api_uri) { return 400 '{"name":"BadRequest","data":{"message":"неверный адрес"}}'; }
        limit_req zone=pcbk_place_rate burst=20 nodelay;
        limit_req_status 509;
        limit_req_log_level warn;
        client_max_body_size 64k;
        proxy_read_timeout 30s;
        proxy_pass http://$pcbk_core;
    }

    # отчёты браузеров (Д6б, Д6-R50): тело ровно {"kind": …} — core сам режет до 256 Б, edge — до 1 КиБ (413 JSON);
    # предел частоты на cookie сессии — 509 → busy.json, как у прочих пределов Д5б (ответ отчёта веб не показывает)
    location = /pcbk/api/web/report {
        default_type application/json;
        if ($pcbk_bad_api_uri) { return 400 '{"name":"BadRequest","data":{"message":"неверный адрес"}}'; }
        limit_req zone=pcbk_web burst=10 nodelay;
        limit_req_status 509;
        limit_req_log_level warn;
        client_max_body_size 1k;
        proxy_read_timeout 10s;
        proxy_pass http://$pcbk_core;
    }

    # вызовы адаптера OpenCode (Д5б): метод, путь и тело сверяет шлюз по белому списку, edge — сырой путь, предел
    # тела, число запросов и сроки. Срок edge больше срока хода у core (25 с, Д5-R30). Тело читается целиком до
    # core: медленное тело держит edge, а не бюджет тел core (16 МиБ). Ответ core читается без остановки: сверх
    # буферов (32k + 4 × 32k) — во временный файл на томе (proxy_temp_path выше), ответ core — до 4 МиБ
    location /pcbk/api/oc/ {
        default_type application/json;
        if ($pcbk_bad_api_uri) { return 400 '{"name":"BadRequest","data":{"message":"неверный адрес"}}'; }
        limit_conn pcbk_oc_session 10;
        limit_conn pcbk_oc_all 64;
        limit_conn_status 509;
        limit_conn_log_level warn;
        limit_req zone=pcbk_oc_rate burst=200 nodelay;
        limit_req_status 509;
        limit_req_log_level warn;
        client_max_body_size 512k;
        client_body_timeout 10s;                  # тело по байту в минуту не держит слот limit_conn (N2)
        proxy_request_buffering on;
        proxy_buffers 4 32k;
        proxy_max_temp_file_size 8m;
        proxy_read_timeout 45s;
        proxy_pass http://$pcbk_core;
    }

    # поток событий: без буфера и сжатия; пульс места — 10 с, шлюз рвёт первым через 60 с тишины места (Д5-R35).
    # send_timeout рвёт только поток, которому edge 60 с не может отправить ни байта (буфер сокета браузера полон);
    # пульс мал, и зависшая вкладка поглощает его часами — такой поток закрывает core через 30 мин (STREAM_MAX_S)
    location = /pcbk/api/oc/event {
        default_type application/json;
        if ($pcbk_bad_api_uri) { return 400 '{"name":"BadRequest","data":{"message":"неверный адрес"}}'; }
        limit_conn pcbk_oc_session 10;
        limit_conn pcbk_oc_all 64;
        limit_conn_status 509;
        limit_conn_log_level warn;
        limit_req zone=pcbk_oc_event burst=60 nodelay;
        limit_req_status 509;
        limit_req_log_level warn;
        client_max_body_size 512k;
        client_body_timeout 10s;
        proxy_request_buffering on;
        proxy_buffers 4 32k;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 90s;
        send_timeout 60s;
        proxy_pass http://$pcbk_core;
    }

    # без косой черты — точные location: иначе auto_redirect даст 301 HTML
    location = /pcbk/api      { default_type application/json; return 404 '{"name":"NotFound","data":{"message":"не найдено"}}'; }
    location = /pcbk/api/auth { default_type application/json; return 404 '{"name":"NotFound","data":{"message":"не найдено"}}'; }
    location = /pcbk/api/oc   { default_type application/json; return 403 '{"name":"Forbidden","data":{"message":"Вызов не разрешён"}}'; }

    # прочее под /pcbk/api/ — 404 JSON; сюда же попадает /pcbk/api/auth/%2e%2e/… после нормализации
    location /pcbk/api/ {
        default_type application/json;
        if ($pcbk_bad_api_uri) { return 400 '{"name":"BadRequest","data":{"message":"неверный адрес"}}'; }
        return 404 '{"name":"NotFound","data":{"message":"не найдено"}}';
    }

    location / {
        default_type "text/plain; charset=utf-8";
        return 404 "не найдено\n";
    }
}

# 8080 — изнутри: живость и статика чата для сторожа; не публикуется
server {
    listen 8080;
    server_name _;
    server_tokens off;
    access_log off;

    location = /healthz {
        default_type "text/plain; charset=utf-8";
        return 200 "ok\n";
    }

    # статика чата для строки сторожа «Веб-чат» (Д6-R46): тот же корень, что у 8443, но без TLS; опись
    # /chat/build.json сторож читает только здесь. Своего root у server 8080 нет — задан в location
    location = /chat/ {
        root /usr/share/nginx/pcbk;
        try_files /chat/index.html =404;
    }

    location ^~ /chat/ {
        root /usr/share/nginx/pcbk;
        try_files $uri =404;
    }

    location / {
        return 404;
    }
}
