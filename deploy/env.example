# Переменные выкладки стенда. Значения стоят только у SECRETS_DIR, AGENTS_DIR и LESSONS_DIR — путей по
# умолчанию, остальное пусто: DOCKER_GID, TLS_DIR и DATA_DIR обязательно заполнить
# (без них docker compose config падает); STU_NET заполнить по правилу подсетей (compose
# его не требует — умолчание 172.31); у прочих пусто — умолчание из compose.yaml.
# Скопировать в /opt/pcbk-reserve/.env, заполнить, chmod 600. Секретов здесь нет:
# контейнерам они — только файлами.

# gid группы docker на сервере: getent group docker | cut -d: -f3 (прокси сокета, задача 4)
DOCKER_GID=
# первые два октета сетей рабочих мест: ${STU_NET}.N.0/28, N = 1…11 (Д2; место 11 — Д15б); обычно 172.31
STU_NET=
# каталог сертификата 8443: сам root 0755, cert.pem root 0644, key.pem root 0600
TLS_DIR=
# пояс времени на странице состояния, например Europe/Moscow; пусто — UTC
DISPLAY_TZ=
# обязательны с Д2: без них docker compose config падает (даже без профиля students)
# секреты мест student-NN.pw и student-NN.llm-token: каталог 0700, файлы 0444; там же bdrv.env,
# core-tokens (Д3а, Д3б) и LLM-прокси (Д4а): llm-tokens, openrouter.key, openrouter-mgmt.key
SECRETS_DIR=/opt/pcbk-reserve/secrets
# агенты студентов: корень 0700, каталоги student-NN — 0755
AGENTS_DIR=/opt/pcbk-reserve/agents
# пакет уроков вкладки «Уроки» (Д15а): только для чтения (core монтирует read_only); обязателен, как AGENTS_DIR —
# без каталога docker compose config падает. Формат — DESIGN Д15а: lessons.json, <id>.md, img/<имя>
LESSONS_DIR=/opt/pcbk-reserve/lessons
# свободная память сервера, МиБ: ниже — «внимание» / «сбой»; пусто — 2048 / 1024
MEM_WARN_MIB=
MEM_FAIL_MIB=
# строка «Память сервера» (Д11): swap сервера вырос за 10 мин на столько, МиБ, — «внимание» «сервер вытесняет
# память в swap»; давление памяти full avg10 выше этого, % (больше 0, не больше 100), 3 такта подряд — «внимание»
# «давление выше порога». Пусто — 512 / 10; окно 1 Д11 (В1) ставит оба по базе сервера: PSI_FULL_MAX = max(5, 3 × база)
SWAP_GROW_WARN_MIB=
PSI_FULL_MAX=
# обязателен с Д3а: каталог белого списка тегов — whitelist.txt 0444 (строит build_whitelist)
# и whitelist.extra; сам каталог 0700, обычно /opt/pcbk-reserve/data. bdrv.env — в SECRETS_DIR
DATA_DIR=
# свежесть историана, с: возраст метки — «внимание» / «сбой»; пусто — 300 / 900 (по пробе — задача 1)
HIST_WARN_S=
HIST_FAIL_S=
# опрос службы данных старше этого — «неизвестно»; пусто — 140 =
# max(120, CATALOG_DEADLINE_S + 2 × FRESH_POLL_S + 20) при CATALOG_DEADLINE_S = 60 и
# FRESH_POLL_S = 30 (период опроса свежести; задаётся в compose.yaml, умолчание 30).
# Пересчитать HIST_STALE_S, если меняется CATALOG_DEADLINE_S или FRESH_POLL_S
HIST_STALE_S=
# общий срок загрузки каталога тегов, с (не меньше 10); пусто — 60
CATALOG_DEADLINE_S=
# учения службы данных (Д9а): tool_error — все инструменты чтения отвечают ошибкой без SQL и без данных
# историана; строка «Историан БДРВ» несёт пометку учений, после трёх вызовов инструмента подряд — «внимание» с его
# именем; агенты студентов тоже получают ошибку — только без студентов. Пусто — учений нет
DRILL_DATA=
# LLM-прокси (Д4а). Модели через запятую из семи кандидатов; пусто — все семь
LLM_MODELS=
# запасная модель (Д14, README «Модели по ролям», абзац «Запасная модель»): пары <основная>=<запасная> через
# запятую, имена — точные имена кандидатов выше (например, z-ai/glm-5.3=z-ai/glm-5.3-flash); пусто — запасного
# пути нет
LLM_FALLBACK=
# выключатель: stopped — /llm/ отказывает всем, строка страницы красная; пусто — on
LLM_STATE=
# учения «на счёте OpenRouter кончились деньги»: 402 — отказ без запроса к OpenRouter; пусто — учений нет
DRILL_LLM=
# доля администратора (токен ops), $; пусто — 100
LLM_OPS_SHARE_USD=
# ключ OpenRouter только у резервного контура: on — расход сверяется с /key; off — ключ общий
# (например, с Dify-стендом), сверки нет; пусто — on
LLM_KEY_DEDICATED=
# общий бюджет LLM-прокси на все места и ops, $ (Д15б): пусто — умолчание кода 1000 (при 11 местах по $100
# страница состояния покажет «внимание»: сумма долей больше общего бюджета); на сервере ПЦБК — 1100
LLM_TOTAL_USD=
# шлюз входа (Д5а). Публичный origin страницы входа: https://<имя сертификата>:8443 — ровно как в
# адресной строке браузера, строчными, без пути; пусто — запись проходит только по
# Sec-Fetch-Site: same-origin браузера
GW_ORIGIN=
# простой рабочего места до сна, с (не меньше 60); пусто — 1800. Только на время окна отбора модели — 10800
# (README, «Прогон отбора модели»); после окна — снова пусто
GW_IDLE_STOP_S=
# прогон отбора модели (Д8; README, «Прогон отбора модели» и «Аварийная уборка»): id прогона ([a-z0-9-], до
# 32 знаков), потолок прогона, $ (больше нуля и не больше общего бюджета), места прогона через запятую
# (student-NN; ops — только для ботов Д11). Все три или ни одного, и только на время окна: после — пусто.
# Ошибка в них — ошибка настройки LLM-прокси, отказ всем вызовам /llm/
LLM_RUN_ID=
LLM_RUN_USD=
LLM_RUN_CALLERS=
# тормоз прогона в core (Д11): работает только при LLM_RUN_* — core раз в 5 с читает память сервера и после 3 проверок
# подряд (убийство по памяти — сразу) останавливает прогон: вызовы модели мест прогона — отказ, места прогона спят и не
# будятся. Свободно меньше LLM_RUN_MEM_FAIL_MIB, МиБ (пусто — MEM_FAIL_MIB, иначе 1024); swap вырос от базы или за
# 10 мин на LLM_RUN_SWAP_GROW_MIB, МиБ (пусто — SWAP_GROW_WARN_MIB, иначе 512); база swap LLM_RUN_SWAP_BASE_MIB, МиБ
# (пусто — первая проверка прогона); давление full avg10 выше LLM_RUN_PSI_FULL_MAX, % (пусто — PSI_FULL_MAX, иначе 10).
# Защёлку снимает только новый LLM_RUN_ID или администратор: docker exec pcbk-core python -m pcbk_core.llm.brake clear
# --run <id> --yes, затем пересоздание core
LLM_RUN_MEM_FAIL_MIB=
LLM_RUN_SWAP_GROW_MIB=
LLM_RUN_SWAP_BASE_MIB=
LLM_RUN_PSI_FULL_MAX=
# строка «LLM-прокси и бюджет»: к моделям прогона отбора не обращались дольше этого, с — «прогон отбора
# молчит»; пусто — 300
LLM_RUN_SILENT_S=
# учения кабинета преподавателя (Д10а), только на время учений: shares_stale — перевод доли пишет диск и журнал
# действий, а LLM-прокси считает по старой доле; journal_down — журнал действий не пишется, кабинет закрыт. Пусто —
# учений нет. Опечатка — ошибка настройки шлюза (вход закрыт) и закрытый LLM-прокси
DRILL_TEACHER=
# аналитический чат технолога КДМ-1 (Task 9): выключатель — on/off (без учёта регистра, допустимо и 1/0,
# true/false, yes/no); пусто — выключена (умолчание), как у старого .env без этой переменной — вход, чат,
# калькуляторы и уроки не затрагивает. README, «Аналитика КДМ-1»
ANALYTICS_ENABLED=
# корпус аналитики — каталог только для чтения (core монтирует в /srv/analytics); НЕОБЯЗАТЕЛЬНА, в отличие от
# LESSONS_DIR/AGENTS_DIR/DATA_DIR — без неё docker compose не падает (умолчание — пустой именованный том
# pcbk-analytics-empty, без настоящих тегов; deploy/analytics-sample каталога репозитория больше нет — на
# сервере его и не было, create_host_path:false не поднял бы старый .env без переменной). На сервере ПЦБК —
# отдельный каталог вне git, ANALYTICS_CORPUS_DIR=/opt/pcbk-reserve/analytics-corpus (каталог 0755, файлы 0644 —
# core в контейнере читает под uid 10003, chmod -R o+rX).
# ВНИМАНИЕ: это хостовый путь (bind-mount source); значение поля настроек ANALYTICS_CORPUS_DIR внутри
# контейнера — отдельное умолчание кода /srv/analytics, сюда не передаётся (docs/kdm1/INTERFACES.md)
ANALYTICS_CORPUS_DIR=
# аналитика: доп. сужение моделей сверх LLM_MODELS активной роли (имена через запятую, llm/models.CANDIDATES);
# пусто — без сужения (умолчание кода)
ANALYTICS_LLM_MODELS=
# аналитика: политика передачи закрытого контекста в LLM (мастер-промпт §9) — public_only | approved_subset |
# none; пусто — умолчание кода public_only (только публичный контекст и абстрактное намерение модели: id
# разрешённого пакета, без текста карточек и без вопроса). approved_subset — решение владельца, итоговая
# правка F6 (14.10.2026, дословно): «4. Разрешен полный контент в тч внутренний и данные с БДРВ»; повторно,
# тем же днём: «Разрашею передачу полного контента в модель!» — модели уходит исходный вопрос технолога и
# тексты карточек пакета (включая внутренние и данные БДРВ, если они есть в пакете); ответ модели всё равно
# ограничен только выбором id (llm-selection.schema.json), сырой текст модели клиенту не выводится никогда.
# none — модель не вызывается вовсе (справочный путь без неё). На сервере ПЦБК — approved_subset (решение
# владельца выше). Опечатка — ошибка настройки (строгий разбор strip/lower), не тихий откат на умолчание
ANALYTICS_LLM_EXPORT_POLICY=
# аналитика: кто решает заявки согласования (reviews/*) — grants | all_students; пусто — умолчание кода grants
# (право только по явному назначению bootstrap/grant, docs/kdm1/REVIEWS_OPERATIONS.md). all_students — решение
# владельца 14.10.2026: любой вошедший student (не teacher) решает любую заявку области без назначения, в
# одно действие (без второго согласующего, без запрета автору); teacher остаётся исключением — только по
# назначению, как в grants. На сервере ПЦБК — all_students (docs/kdm1/REVIEWS_OPERATIONS.md, раздел «Режим
# ANALYTICS_REVIEWERS»). Опечатка — ошибка настройки, не тихий откат на grants
ANALYTICS_REVIEWERS=
# аналитика: плательщик платного разбора для преподавателя настроен — непустая строка-флаг (мастер-промпт §6);
# пусто (умолчание) — платный путь для преподавателя недоступен, справочный путь работает
ANALYTICS_TEACHER_PAYER=
# аналитика: сроки хранения диалогов/сообщений и пакетов доказательств, дни; пусто — умолчание кода 365.0 у
# обоих (раздельные сроки — пакет доказательств может жить дольше истории чата)
ANALYTICS_HISTORY_RETENTION_DAYS=
ANALYTICS_EVIDENCE_RETENTION_DAYS=
# аналитика: срок одной стадии задания до failed по таймауту, с; пусто — умолчание кода 120.0
ANALYTICS_JOB_TIMEOUT_S=
