# Переменные выкладки стенда — без значений. Скопировать в /opt/pcbk-reserve/.env,
# заполнить, chmod 600. Секретов здесь нет: контейнерам они — только файлами.

# gid группы docker на сервере: getent group docker | cut -d: -f3 (прокси сокета, задача 4)
DOCKER_GID=
# первые два октета сетей рабочих мест: ${STU_NET}.N.0/28, N = 1…10 (Д2); обычно 172.31
STU_NET=
# каталог сертификата 8443: сам root 0755, cert.pem root 0644, key.pem root 0600
TLS_DIR=
# пояс времени на странице состояния, например Europe/Moscow; пусто — UTC
DISPLAY_TZ=
# каталог файлов-секретов (с Д3)
SECRETS_DIR=
# каталог файлов агентов студентов (с Д2)
AGENTS_DIR=
# свободная память сервера, МиБ: ниже — «внимание» / «сбой»; пусто — 2048 / 1024
MEM_WARN_MIB=
MEM_FAIL_MIB=
